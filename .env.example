# ====================================================================
# DIPA-Bot — Chatbot Akademik UNDIPA
# Contoh konfigurasi environment. Salin file ini menjadi ".env" lalu
# sesuaikan nilainya dengan server tujuan. File ".env" TIDAK di-commit.
# config/database.php membaca nilai dari .env (default: XAMPP).
# ====================================================================

# Host database (localhost untuk XAMPP/MariaDB lokal, atau nama service Docker seperti mariadb-pusat)
DB_HOST=localhost

# Nama database aplikasi
DB_NAME=chatbot_undipa

# User database
DB_USER=root

# Password database (kosong = default XAMPP)
DB_PASS=

# Charset koneksi
DB_CHARSET=utf8mb4