# ====================================================================
# DIPA-Bot — Chatbot Akademik UNDIPA
# Contoh konfigurasi environment.
#
# Cara pakai (XAMPP):
#   1. Salin file ini menjadi ".env" ->   cp .env.example .env
#   2. Sesuaikan nilainya dengan server local.
#   3. Config/database.php membaca environment variable (getenv)
#      dengan default XAMPP berikut, jadi nilai statis juga valid.
#
# Nilai ini HANYA contoh — jangan pernah commit file ".env" asli.
# ====================================================================

# Host database (localhost untuk XAMPP/MariaDB lokal, atau nama service Docker seperti mariadb-pusat)
DB_HOST=localhost

# Nama database aplikasi
DB_NAME=chatbot_undipa

# User database
DB_USER=root

# Password database (kosong = default XAMPP)
DB_PASS=

# Charset koneksi
DB_CHARSET=utf8mb4